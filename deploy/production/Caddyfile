# HTTPS certificates are obtained/renewed by Caddy for the configured DNS name.
# Access logging stays off to keep OAuth authorization codes out of URL logs.
{$CLOUDSENTINEL_DOMAIN} {
  request_body {
    max_size 2MB
  }
  reverse_proxy api:8000 {
    transport http {
      dial_timeout 5s
      response_header_timeout 30s
    }
  }
}
