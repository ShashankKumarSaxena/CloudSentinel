# Host scripts do not load this file automatically. Export selected values locally.
# Docker Compose reads .env for interpolation only; use the documented override
# to pass application settings into the container. Never store secrets here.

# Local state / server settings
# export CLOUDSENTINEL_DB=/absolute/path/to/cloudsentinel.db
# export CLOUDSENTINEL_ALLOWED_HOSTS=127.0.0.1,localhost
# export CLOUDSENTINEL_MONITORING=1
# export CLOUDSENTINEL_DOCS=1
# Secure cookies require HTTPS; leave 0 for the supplied loopback HTTP deployment.
# export CLOUDSENTINEL_SECURE_COOKIES=0
# Compose host port (set in your shell or an ignored .env file):
# CLOUDSENTINEL_PORT=8000

# Read-only cloud access is optional. No credentials needed for synthetic scans.
# export AWS_PROFILE=cloudsentinel-readonly
# export AZURE_SUBSCRIPTION_ID=your-subscription-id
# export GOOGLE_CLOUD_PROJECT=your-project-id
# Azure/GCP normally use local CLIs; containers can use explicit token files.
# export CLOUDSENTINEL_AZURE_TOKEN_FILE=/run/secrets/azure_token
# export CLOUDSENTINEL_GCP_TOKEN_FILE=/run/secrets/gcp_token

# SMTP is disabled by default. Explicitly enable only with reviewed recipients.
# Values are read on startup. Passwords are read from a local file at delivery.
# export CLOUDSENTINEL_SMTP_ENABLED=1
# export CLOUDSENTINEL_SMTP_HOST=smtp.example.org
# export CLOUDSENTINEL_SMTP_PORT=587
# export CLOUDSENTINEL_SMTP_TLS=starttls
# export CLOUDSENTINEL_SMTP_FROM=cloudsentinel@example.org
# export CLOUDSENTINEL_SMTP_TO=security@example.org
# export CLOUDSENTINEL_SMTP_USER=cloudsentinel@example.org
# export CLOUDSENTINEL_SMTP_PASSWORD_FILE=/run/secrets/smtp_password
# export CLOUDSENTINEL_ALERT_MIN_SEVERITY=high
# TLS modes: starttls or ssl. Severity: critical, high, medium, low.
# All matching new alerts (including synthetic alerts) may be emailed when enabled.
