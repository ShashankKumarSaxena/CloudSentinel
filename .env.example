# Optional: set this in the shell before launching to use another local database.
# The application does not automatically load .env files.
# export CLOUDSENTINEL_DB=/absolute/path/to/cloudsentinel.db

# Phase 2 collectors are opt-in and use local provider credentials.
# No credentials are needed to run the synthetic activity demo.
# export AWS_PROFILE=cloudsentinel-readonly
# export AZURE_SUBSCRIPTION_ID=your-subscription-id
# export GOOGLE_CLOUD_PROJECT=your-project-id
