# Host scripts do not automatically load .env files. Export selected values.
# For production Compose use deploy/production/.env.example and docs/deployment.md.
# Never place passwords, access keys, or bearer tokens in this file.

# Offline demo (defaults)
# export CLOUDSENTINEL_MODE=demo
# export CLOUDSENTINEL_DB=/absolute/path/to/cloudsentinel.db
# export CLOUDSENTINEL_PUBLIC_URL=http://127.0.0.1:8000
# export CLOUDSENTINEL_ALLOWED_HOSTS=127.0.0.1,localhost
# export CLOUDSENTINEL_MONITORING=1
# export CLOUDSENTINEL_DOCS=1
# CLOUDSENTINEL_PORT=8000

# Production application settings; prefer file-backed secrets and the Compose package.
# export CLOUDSENTINEL_MODE=production
# export CLOUDSENTINEL_DATABASE_URL_FILE=/run/secrets/database_url
# export CLOUDSENTINEL_MODEL_DIR=/var/lib/cloudsentinel/models
# export CLOUDSENTINEL_ACCOUNTS_FILE=/config/accounts.json
# export CLOUDSENTINEL_PUBLIC_URL=https://security.example.com
# export CLOUDSENTINEL_ALLOWED_HOSTS=security.example.com,127.0.0.1
# export CLOUDSENTINEL_SECURE_COOKIES=1
# export CLOUDSENTINEL_MONITORING=0
# export CLOUDSENTINEL_DOCS=0
# export CLOUDSENTINEL_LIVE_ML_ENABLED=0
# export CLOUDSENTINEL_MAX_PENDING_JOBS=500
# export CLOUDSENTINEL_WORKER_STALE_SECONDS=240
# export CLOUDSENTINEL_SESSION_TTL_SECONDS=3600
# export CLOUDSENTINEL_IDLE_TIMEOUT_SECONDS=900

# Optional OIDC: all four settings must be supplied together.
# export CLOUDSENTINEL_OIDC_ISSUER=https://identity.example.com
# export CLOUDSENTINEL_OIDC_CLIENT_ID=cloudsentinel
# export CLOUDSENTINEL_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# export CLOUDSENTINEL_OIDC_STATE_SECRET_FILE=/run/secrets/oidc_state

# Explicit opt-in email; review recipients before enabling.
# export CLOUDSENTINEL_SMTP_ENABLED=1
# export CLOUDSENTINEL_SMTP_HOST=smtp.example.org
# export CLOUDSENTINEL_SMTP_PORT=587
# export CLOUDSENTINEL_SMTP_TLS=starttls
# export CLOUDSENTINEL_SMTP_FROM=cloudsentinel@example.org
# export CLOUDSENTINEL_SMTP_TO=security@example.org
# export CLOUDSENTINEL_SMTP_USER=cloudsentinel@example.org
# export CLOUDSENTINEL_SMTP_PASSWORD_FILE=/run/secrets/smtp_password
# export CLOUDSENTINEL_ALERT_MIN_SEVERITY=high
# TLS modes: starttls/ssl. Severity: critical/high/medium/low.
